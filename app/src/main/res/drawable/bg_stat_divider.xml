<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!--
        Vertical fade divider matching Figma's "Rectangle 114":
        1px wide, 44dp tall, transparent at both ends, ~20% opacity
        #1C2028 in the middle. android:angle="90" makes the gradient
        run top-to-bottom (0 = left-to-right is the default).
    -->
    <gradient
        android:type="linear"
        android:angle="90"
        android:startColor="#001C2028"
        android:centerColor="#331C2028"
        android:endColor="#001C2028" />

</shape>