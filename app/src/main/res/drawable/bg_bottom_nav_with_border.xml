<?xml version="1.0" encoding="utf-8"?>
<!-- res/drawable/bg_bottom_nav_with_border.xml -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base background with rounded top corners -->
    <item>
        <shape>
            <solid android:color="?attr/colorSurface" />
            <corners
                android:topLeftRadius="16dp"
                android:topRightRadius="16dp" />
        </shape>
    </item>

    <!-- Top border -->
    <item android:height="1dp" android:gravity="top">
        <shape>
            <solid android:color="?attr/colorOutline" />
        </shape>
    </item>

    <!-- Left border -->
    <item android:width="1dp" android:gravity="left">
        <shape>
            <solid android:color="?attr/colorOutline" />
        </shape>
    </item>

    <!-- Right border -->
    <item android:width="1dp" android:gravity="right">
        <shape>
            <solid android:color="?attr/colorOutline" />
        </shape>
    </item>
</layer-list>