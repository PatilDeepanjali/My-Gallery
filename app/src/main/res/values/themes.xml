<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.MyGallery" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/blue_100</item>
        <item name="colorPrimaryVariant">@color/blue_40</item>
        <item name="colorSurfaceVariant">@color/blue_20</item>
    </style>

    <style name="Theme.MyGallery" parent="Base.Theme.MyGallery" />

    <!--
        Accent color variants — hex values are inlined directly here
        instead of referencing @color/accent_x. Since these colors are
        the SAME in light and dark mode, this avoids needing any
        colors.xml changes at all for this part of the feature.
    -->

    <style name="Theme.MyGallery.Blue" parent="Base.Theme.MyGallery" />

    <style name="Theme.MyGallery.Green" parent="Base.Theme.MyGallery">
        <item name="colorPrimary">#FF2ECC71</item>
        <item name="colorPrimaryVariant">#662ECC71</item>
    </style>

    <style name="Theme.MyGallery.Pink" parent="Base.Theme.MyGallery">
        <item name="colorPrimary">#FFF0578D</item>
        <item name="colorPrimaryVariant">#66F0578D</item>
    </style>

    <style name="Theme.MyGallery.Purple" parent="Base.Theme.MyGallery">
        <item name="colorPrimary">#FF7C3AED</item>
        <item name="colorPrimaryVariant">#667C3AED</item>
    </style>

    <style name="Theme.MyGallery.Teal" parent="Base.Theme.MyGallery">
        <item name="colorPrimary">#FF2DD4BF</item>
        <item name="colorPrimaryVariant">#662DD4BF</item>
    </style>

    <style name="Theme.MyGallery.Yellow" parent="Base.Theme.MyGallery">
        <item name="colorPrimary">#FFF2C94C</item>
        <item name="colorPrimaryVariant">#66F2C94C</item>
    </style>

    <style name="Theme.MyGallery.Red" parent="Base.Theme.MyGallery">
        <item name="colorPrimary">#FFB03A2E</item>
        <item name="colorPrimaryVariant">#66B03A2E</item>
    </style>

    <style name="Theme.MyGallery.Violet" parent="Base.Theme.MyGallery">
        <item name="colorPrimary">#FFD66EF0</item>
        <item name="colorPrimaryVariant">#66D66EF0</item>
    </style>

</resources>