<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center"
        android:layout_marginBottom="18dp"
        android:background="@drawable/bg_bottom_sheet_handle" />

    <!-- Ui Mode title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_sort2"
            app:tint="@color/blue_100" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="Ui Mode"
            android:textColor="@color/blue_100"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Ui Mode options card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_sheet_option"
        android:orientation="vertical">

        <!-- System -->
        <LinearLayout
            android:id="@+id/layoutSystem"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_details" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="System"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/imgSystemCheck"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_plane_circle" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E8E8E8" />

        <!-- Light -->
        <LinearLayout
            android:id="@+id/layoutLight"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_details" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="Light"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/imgLightCheck"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_plane_circle" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E8E8E8" />

        <!-- Dark -->
        <LinearLayout
            android:id="@+id/layoutDark"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_details" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="Dark"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/imgDarkCheck"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_plane_circle" />

        </LinearLayout>

    </LinearLayout>

    <!-- Theme Color title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_sort2"
            app:tint="@color/blue_100" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="Theme Color"
            android:textColor="@color/blue_100"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Swatch grid card — rows filled in by Kotlin -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_sheet_option"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:id="@+id/rowSwatches1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

        <LinearLayout
            android:id="@+id/rowSwatches2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal" />

    </LinearLayout>

</LinearLayout>