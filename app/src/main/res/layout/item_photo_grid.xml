<?xml version="1.0" encoding="utf-8"?>

<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardPhoto"
    android:layout_width="match_parent"
    android:layout_height="85dp"
    android:layout_margin="2dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="0dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="85dp">

        <!-- Photo -->
        <ImageView
            android:id="@+id/imgPhoto"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@string/photo_thumbnail"
            tools:src="@tools:sample/backgrounds/scenic" />

        <!-- Favorite toggle — always visible (not just in selection
             mode), tappable independently of the rest of the item -->


        <FrameLayout
            android:id="@+id/favoriteButton"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="top|start"
            android:layout_margin="6dp"
            android:background="@drawable/bg_favorite_circle"
            android:elevation="2dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:id="@+id/imgFavorite"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_red_heart"
                android:contentDescription="Favorite" />

        </FrameLayout>

        <!-- Selection Checkbox -->
        <ImageView
            android:id="@+id/iv_checkbox"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="top|end"
            android:layout_margin="6dp"
            android:src="@drawable/ic_check_circle_filled"
            android:visibility="gone"
            android:contentDescription="@string/photo_selection"
            tools:visibility="visible" />

    </FrameLayout>

</androidx.cardview.widget.CardView>