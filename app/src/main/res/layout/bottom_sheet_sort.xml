<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_bottom_sheet_handle" />

    <!-- Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_sort2"
            app:tint="@color/blue_100" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="Sort By"
            android:textColor="@color/blue_100"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Sort Type Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_sheet_option"
        android:orientation="vertical">

        <!-- Date Taken -->
        <LinearLayout
            android:id="@+id/layoutDateTaken"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_calendar" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="Date Taken"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/imgDateTakenCheck"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_plane_circle" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E8E8E8" />

        <!-- Last Modified -->
        <LinearLayout
            android:id="@+id/layoutLastModified"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_edit" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="Last Modified"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/imgLastModifiedCheck"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_check_circle_filled" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E8E8E8" />

        <!-- Album Name -->
        <LinearLayout
            android:id="@+id/layoutAlbumName"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_album" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="Album Name"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/imgAlbumNameCheck"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_plane_circle" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E8E8E8" />

        <!-- Size -->
        <LinearLayout
            android:id="@+id/layoutSize"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_size" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="Size"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/imgSizeCheck"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_plane_circle" />

        </LinearLayout>

    </LinearLayout>

    <!-- Order Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_sheet_option"
        android:orientation="vertical">

        <!-- Ascending -->
        <LinearLayout
            android:id="@+id/layoutAscending"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_asending" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="Ascending"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/imgAscendingCheck"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_plane_circle" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E8E8E8" />

        <!-- Descending -->
        <LinearLayout
            android:id="@+id/layoutDescending"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_desc" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="Descending"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/imgDescendingCheck"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_plane_circle" />

        </LinearLayout>

    </LinearLayout>

    <!-- Bottom Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancel"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="Cancel"
            android:textAllCaps="false"
            android:textColor="@color/blue_100"
            app:backgroundTint="@color/background"
            app:cornerRadius="14dp"
            app:strokeColor="@color/blue_100"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnApply"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Apply"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            app:backgroundTint="@color/blue_100"
            app:cornerRadius="14dp" />

    </LinearLayout>

</LinearLayout>