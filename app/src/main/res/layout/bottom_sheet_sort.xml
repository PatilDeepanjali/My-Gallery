<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_bottom_sheet_handle" />

    <!-- Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_sort2"
            app:tint="@color/blue_100" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="Sort By"
            android:textColor="@color/blue_100"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!--
        Sort Type Card — 4 generic option rows. Each Kotlin class using
        this layout (SortBottomSheet for Photos, AlbumSortBottomSheet
        for Album) sets its OWN icon + label text + click behavior for
        each slot at runtime. Nothing photo- or album-specific is
        hardcoded here anymore — that's what makes this one file
        genuinely reusable instead of two similar-looking copies.
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_sheet_option"
        android:orientation="vertical">

        <!-- Option 1 -->
        <LinearLayout
            android:id="@+id/layoutOption1"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp">

            <ImageView
                android:id="@+id/imgOption1Icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_calendar" />

            <TextView
                android:id="@+id/tvOption1Label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="Option 1"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/imgOption1Check"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_plane_circle" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E8E8E8" />

        <!-- Option 2 -->
        <LinearLayout
            android:id="@+id/layoutOption2"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp">

            <ImageView
                android:id="@+id/imgOption2Icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_edit" />

            <TextView
                android:id="@+id/tvOption2Label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="Option 2"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/imgOption2Check"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_plane_circle" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E8E8E8" />

        <!-- Option 3 -->
        <LinearLayout
            android:id="@+id/layoutOption3"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp">

            <ImageView
                android:id="@+id/imgOption3Icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_album" />

            <TextView
                android:id="@+id/tvOption3Label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="Option 3"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/imgOption3Check"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_plane_circle" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E8E8E8" />

        <!-- Option 4 -->
        <LinearLayout
            android:id="@+id/layoutOption4"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp">

            <ImageView
                android:id="@+id/imgOption4Icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_size" />

            <TextView
                android:id="@+id/tvOption4Label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="Option 4"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/imgOption4Check"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_plane_circle" />

        </LinearLayout>

    </LinearLayout>

    <!-- Order Card — kept as-is; Ascending/Descending are genuinely
         identical concepts in both contexts, no per-screen config needed. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_sheet_option"
        android:orientation="vertical">

        <!-- Ascending -->
        <LinearLayout
            android:id="@+id/layoutAscending"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_asending" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="Ascending"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/imgAscendingCheck"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_plane_circle" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E8E8E8" />

        <!-- Descending -->
        <LinearLayout
            android:id="@+id/layoutDescending"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_desc" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="Descending"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/imgDescendingCheck"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_plane_circle" />

        </LinearLayout>

    </LinearLayout>

    <!-- Bottom Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancel"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="Cancel"
            android:textAllCaps="false"
            android:textColor="@color/blue_100"
            app:backgroundTint="@color/background"
            app:cornerRadius="14dp"
            app:strokeColor="@color/blue_100"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnApply"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Apply"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            app:backgroundTint="@color/blue_100"
            app:cornerRadius="14dp" />

    </LinearLayout>

</LinearLayout>